<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools"
          package="com.vkm.reportahealth">

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>

    <application
            android:name=".ReportaHealthApp"
            android:allowBackup="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:supportsRtl="true"
            android:theme="@style/AppTheme"
            tools:ignore="GoogleAppIndexingWarning">
        <activity android:name=".ui.stats.FacilityListActivity">
        </activity>

        <meta-data
                android:name="com.google.android.gms.version"
                android:value="@integer/google_play_services_version"/>
        <meta-data
                android:name="com.google.android.geo.API_KEY"
                android:value="@string/google_maps_key"/>

        <activity
                android:name=".ui.facilities.FacilitiesActivity"
                android:label="@string/app_name"
                android:theme="@style/AppTheme.NoActionBarX">
        </activity>
<!--        <activity-->
<!--                android:name=".ui.splashscreen.SplashActivity"-->
<!--                android:exported="true"-->

<!--                android:theme="@style/AppTheme.NoActionBarX">-->
<!--            <intent-filter>-->
<!--                <action android:name="android.intent.action.MAIN"/>-->

<!--                <category android:name="android.intent.category.LAUNCHER"/>-->
<!--            </intent-filter>-->
<!--        </activity>-->
        <activity
            android:name=".ui.splashscreen.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.login.LoginActivity" />
        <activity
                android:name=".ui.home.HomeActivity"
                android:theme="@style/AppTheme.NoActionBarX"/>
        <activity
                android:name=".ui.directions.DirectionsActivity"
                android:theme="@style/AppTheme.NoActionBarX"/>
        <activity
                android:name=".ui.facilities.SubmitFacilityActivity"
                android:theme="@style/AppTheme"/>
        <activity
                android:name=".ui.facilities.FacilityReviewsActivity"
                android:theme="@style/AppTheme"/>
        <activity
                android:name=".ui.stats.StatsActivity"
                android:theme="@style/AppTheme"/>
        <activity
                android:name=".ui.stats.FullStatsActivity"
                android:theme="@style/AppTheme"/>
        <activity
                android:name=".ui.account.ProfileActivity"
                android:theme="@style/AppTheme"/>
    </application>

</manifest>