<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
                                       xmlns:app="http://schemas.android.com/apk/res-auto"
                                       xmlns:tools="http://schemas.android.com/tools"
                                       android:orientation="vertical"
                                       android:layout_width="match_parent"
                                       android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="32dp"
        android:background="@drawable/edt_bg">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:id="@+id/statsTextContainer">
            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="16dp"
                    android:layout_marginStart="16dp"
                    tools:text="Lagos"
                    android:textColor="@color/colorAccent"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:id="@+id/locationTextView"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:background="@drawable/btn_bordered"
                android:text="View More"
                android:visibility="gone"
                tools:visibility="visible"
                android:paddingStart="16dp"
                android:paddingRight="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="5dp"
                android:textColor="@color/colorAccent"
                android:textStyle="normal"
                android:paddingBottom="5dp"
                android:layout_toLeftOf="@+id/viewStatsButton"
                android:layout_toStartOf="@+id/viewStatsButton"
                android:layout_marginRight="10dp"
                android:id="@+id/viewDetailsButton"
                android:layout_marginEnd="10dp"
                android:paddingLeft="16dp"/>
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_account"
                app:tint="@color/blue" />
        </RelativeLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/divider"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginEnd="16dp"
            android:id="@+id/statsDivider"
            android:layout_marginStart="16dp"/>

        <org.eazegraph.lib.charts.BarChart
                android:id="@+id/barChartStat"
                android:layout_width="match_parent"
                android:layout_height="256dp"
                android:padding="16dp"
                app:egBarMargin="35dp"
                app:egFixedBarWidth="true"
                app:egBarWidth="30dp"
                app:egLegendHeight="40dp"
                app:egLegendTextSize="10sp"
        android:visibility="visible"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/divider"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/textColorPrimary"
            android:text="Hospitals and Clinics by level of care"
            android:layout_marginBottom="10dp"/>

<!--        <com.razerdp.widget.animatedpieview.AnimatedPieView-->
<!--                android:layout_width="wrap_content"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:layout_marginLeft="32dp"-->
<!--                android:layout_gravity="center"-->
<!--                android:layout_marginStart="32dp"-->
<!--                android:layout_marginEnd="32dp"-->
<!--                android:layout_marginRight="32dp"-->
<!--                android:layout_marginBottom="16dp"-->
<!--                android:id="@+id/pieViewLevelOfCare"/>-->

        <com.github.mikephil.charting.charts.PieChart
            android:id="@+id/pieViewByOwnerShip"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            tools:ignore="DuplicateIds" />

        <com.github.mikephil.charting.charts.PieChart
            android:id="@+id/pieViewLevelOfCare"
            android:layout_width="match_parent"
            android:layout_height="300dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/textColorPrimary"
            android:text="Hospitals and Clinics by Ownership"
            android:layout_marginBottom="10dp"/>

<!--        <com.razerdp.widget.animatedpieview.AnimatedPieView-->
<!--                android:layout_width="300dp"-->
<!--                android:layout_height="300dp"-->
<!--                android:layout_marginLeft="32dp"-->
<!--                android:layout_gravity="center"-->
<!--                android:layout_marginStart="32dp"-->
<!--                android:layout_marginEnd="32dp"-->
<!--                android:layout_marginRight="32dp"-->
<!--                android:layout_marginBottom="16dp"-->
<!--                android:id="@+id/pieViewByOwnerShip"/>-->

        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/ButtonStyle.BorderLess"
            android:textColor="@color/colorAccent"
            android:layout_marginTop="5dp"
            android:layout_gravity="center"
            android:id="@+id/buttonViewLgaFacilities"
            android:layout_marginBottom="5dp"
            android:textAllCaps="false"
            android:text="@string/view_lgas"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>