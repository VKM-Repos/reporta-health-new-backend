# ================================
# Django Core Settings
# ================================
SECRET_KEY=django-insecure-change-this-in-production-a8d9f7b6c5e4d3a2b1
DEBUG=True
DJANGO_ENVIRONMENT=development
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ================================
# Database Configuration
# ================================
DB_NAME=reporta_health
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# ================================
# CORS Settings
# ================================
# For React Native development (Metro bundler on different ports)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19000,http://localhost:19001,http://192.168.1.1:8081

# ================================
# JWT Authentication
# ================================
# Token lifetime in minutes (60 = 1 hour)
JWT_ACCESS_TOKEN_LIFETIME=60
# Refresh token lifetime in days
JWT_REFRESH_TOKEN_LIFETIME=7

# ================================
# Email Configuration
# ================================
# For development, emails will print to console
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# For production with Gmail (uncomment and configure):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-gmail-app-password
# DEFAULT_FROM_EMAIL=noreply@reportahealth.com

# For production with SendGrid (uncomment and configure):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your-sendgrid-api-key
# DEFAULT_FROM_EMAIL=noreply@reportahealth.com

# ================================
# Redis Configuration
# ================================
REDIS_URL=redis://localhost:6379/0

# ================================
# AWS S3 Configuration (Optional)
# ================================
# Set to True to use S3 for media files in production
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=reporta-health-media
AWS_S3_REGION_NAME=us-east-1

# ================================
# Sentry Error Tracking (Optional)
# ================================
# Get your DSN from https://sentry.io
SENTRY_DSN=

# ================================
# Application URLs
# ================================
# Base URL for password reset links, etc.
FRONTEND_URL=http://localhost:3000
APP_NAME=Reporta Health

# ================================
# Celery Configuration
# ================================
# Uses Redis URL by default
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ================================
# Google Maps API (Optional)
# ================================
# For geocoding addresses to coordinates
GOOGLE_MAPS_API_KEY=

# ================================
# Rate Limiting
# ================================
# Requests per hour for non-cached endpoints
RATE_LIMIT_PER_HOUR=1000

# ================================
# File Upload Settings
# ================================
# Max file size in MB
MAX_UPLOAD_SIZE=10

# ================================
# Admin Configuration
# ================================
# Superuser credentials (for docker initialization)
DJANGO_SUPERUSER_EMAIL=admin@reportahealth.com
DJANGO_SUPERUSER_PASSWORD=admin123
DJANGO_SUPERUSER_USERNAME=admin