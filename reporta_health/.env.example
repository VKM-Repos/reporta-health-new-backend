# ================================
# Django Core Settings
# ================================
SECRET_KEY=your-secret-key-here-generate-with-python-c-"from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DEBUG=True
DJANGO_ENVIRONMENT=development
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ================================
# Database Configuration
# ================================
DB_NAME=reporta_health
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# ================================
# CORS Settings
# ================================
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19000,http://localhost:19001

# ================================
# JWT Authentication
# ================================
# Token lifetime in minutes (60 = 1 hour)
JWT_ACCESS_TOKEN_LIFETIME=60
# Refresh token lifetime in days
JWT_REFRESH_TOKEN_LIFETIME=7

# ================================
# Email Configuration
# ================================
# For development, emails will print to console
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# For production with Gmail (uncomment and configure):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-gmail-app-password
# DEFAULT_FROM_EMAIL=noreply@reportahealth.com

# For production with SendGrid (uncomment and configure):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your-sendgrid-api-key
# DEFAULT_FROM_EMAIL=noreply@reportahealth.com

# ================================
# Redis Configuration
# ================================
REDIS_URL=redis://localhost:6379/0

# ================================
# Celery Configuration
# ================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ================================
# AWS S3 Configuration (Optional)
# ================================
# Set to True to use S3 for media files in production
USE_S3=False
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_REGION_NAME=us-east-1

# ================================
# Sentry Error Tracking (Optional)
# ================================
# Get your DSN from https://sentry.io
SENTRY_DSN=

# ================================
# Site Configuration
# ================================
SITE_URL=http://localhost:8000
ADMIN_EMAIL=admin@reportahealth.com
FRONTEND_URL=http://localhost:3000
APP_NAME=Reporta Health

# ================================
# Google Maps API (Optional)
# ================================
# For geocoding addresses to coordinates
GOOGLE_MAPS_API_KEY=

# ================================
# Rate Limiting
# ================================
# Requests per hour for non-cached endpoints
RATE_LIMIT_PER_HOUR=1000

# ================================
# File Upload Settings
# ================================
# Max file size in MB
MAX_UPLOAD_SIZE=10

# ================================
# Admin Configuration
# ================================
# Superuser credentials for initial setup
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me-immediately
DJANGO_SUPERUSER_USERNAME=admin