    SARCFacility:
      type: object
      description: |-
        Facility serializer with nested SARC profile.
        Extends the list serializer so distance works for nearby queries.
      properties:
        id:
          type: integer
          readOnly: true
        name:
          type: string
          title: Facility name
          maxLength: 255
        facility_type:
          $ref: '#/components/schemas/FacilityTypeEnum'
        address:
          type: string
        city:
          type: string
          maxLength: 100
        state:
          type: string
          maxLength: 100
        location:
          type: object
          properties:
            latitude:
              type: number
              format: float
            longitude:
              type: number
              format: float
          readOnly: true
        phone_number:
          type: string
          maxLength: 20
        average_rating:
          type: string
          format: decimal
          pattern: ^-?\d{0,1}(?:\.\d{0,2})?$
        total_reviews:
          type: integer
          maximum: 2147483647
          minimum: -2147483648
        is_verified:
          type: boolean
          title: Verified
          description: Has this facility been verified by admin?
        distance:
          type: number
          format: float
          description: Get distance from user location if available
          readOnly: true
        primary_image:
          type: string
          format: uri
          description: Get primary image URL
          readOnly: true
        has_sarcs:
          type: boolean
          title: Has SARC
          description: Does this facility have a Sexual Assault Referral Centre unit?
        sarc_profile:
          allOf:
          - $ref: '#/components/schemas/SARCProfile'
          readOnly: true
        is_standalone_sarc:
          type: string
          readOnly: true
      required:
      - address
      - distance
      - facility_type
      - id
      - is_standalone_sarc
      - location
      - name
      - primary_image
      - sarc_profile
    SARCProfile:
      type: object
      properties:
        unit_name:
          type: string
          title: SARC unit name
          description: Name of the SARC unit e.g. Hope Centre
          maxLength: 255
        hotline_number:
          type: string
          description: 24/7 crisis hotline number
          maxLength: 20
        is_24_hours:
          type: boolean
          title: 24 hour service
        accepts_walk_ins:
          type: boolean
        confidentiality_assured:
          type: boolean
        has_police_presence:
          type: boolean
        has_legal_aid:
          type: boolean
        has_counseling:
          type: boolean
        has_hiv_pep:
          type: boolean
        has_emergency_contraception:
          type: boolean
        has_shelter_referral:
          type: boolean
        has_forensic:
          type: boolean
          title: Has forensic examination
        has_sti_testing:
          type: boolean
        has_court_support:
          type: boolean
        languages:
          title: Languages supported
          description: List of languages spoken e.g. ["English", "Yoruba"]
        additional_info:
          type: string
          title: Additional information
