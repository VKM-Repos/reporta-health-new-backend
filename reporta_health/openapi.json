components:
  schemas:
    Activation:
      type: object
      properties:
        uid:
          type: string
        token:
          type: string
      required:
      - token
      - uid
    ActivationRequest:
      type: object
      properties:
        uid:
          type: string
          minLength: 1
        token:
          type: string
          minLength: 1
      required:
      - token
      - uid
    CareLevelCount:
      type: object
      properties:
        care_level:
          type: string
        care_level_label:
          type: string
        count:
          type: integer
      required:
      - care_level
      - care_level_label
      - count
    FacilityCreate:
      type: object
      description: Serializer for creating a facility
      properties:
        name:
          type: string
          title: Facility name
          maxLength: 255
        facility_type:
          $ref: '#/components/schemas/FacilityTypeEnum'
        address:
          type: string
        city:
          type: string
          maxLength: 100
        state:
          type: string
          maxLength: 100
        phone_number:
          type: string
          maxLength: 20
        email:
          type: string
          format: email
          maxLength: 254
        website:
          type: string
          format: uri
          maxLength: 200
        description:
          type: string
        services:
          type: string
          title: Services offered
          description: Comma-separated list of services
        monday_hours:
          type: string
          maxLength: 50
        tuesday_hours:
          type: string
          maxLength: 50
        wednesday_hours:
          type: string
          maxLength: 50
        thursday_hours:
          type: string
          maxLength: 50
        friday_hours:
          type: string
          maxLength: 50
        saturday_hours:
          type: string
          maxLength: 50
        sunday_hours:
          type: string
          maxLength: 50
        has_parking:
          type: boolean
        has_wheelchair_access:
          type: boolean
          title: Wheelchair accessible
        has_emergency_service:
          type: boolean
      required:
      - address
      - facility_type
      - name
    FacilityCreateRequest:
      type: object
      description: Serializer for creating a facility
      properties:
        name:
          type: string
          minLength: 1
          title: Facility name
          maxLength: 255
        facility_type:
          $ref: '#/components/schemas/FacilityTypeEnum'
        address:
          type: string
          minLength: 1
        city:
          type: string
          maxLength: 100
        state:
          type: string
          maxLength: 100
        latitude:
          type: number
          format: double
          writeOnly: true
        longitude:
          type: number
          format: double
          writeOnly: true
        phone_number:
          type: string
          maxLength: 20
        email:
          type: string
          format: email
          maxLength: 254
        website:
          type: string
          format: uri
          maxLength: 200
        description:
          type: string
        services:
          type: string
          title: Services offered
          description: Comma-separated list of services
        monday_hours:
          type: string
          maxLength: 50
        tuesday_hours:
          type: string
          maxLength: 50
        wednesday_hours:
          type: string
          maxLength: 50
        thursday_hours:
          type: string
          maxLength: 50
        friday_hours:
          type: string
          maxLength: 50
        saturday_hours:
          type: string
          maxLength: 50
        sunday_hours:
          type: string
          maxLength: 50
        has_parking:
          type: boolean
        has_wheelchair_access:
          type: boolean
          title: Wheelchair accessible
        has_emergency_service:
          type: boolean
      required:
      - address
      - facility_type
      - latitude
      - longitude
      - name
    FacilityDetail:
      type: object
      description: Detailed serializer for single facility view
      properties:
        id:
          type: integer
          readOnly: true
        name:
          type: string
          title: Facility name
          maxLength: 255
        facility_type:
          $ref: '#/components/schemas/FacilityTypeEnum'
        address:
          type: string
        city:
          type: string
          maxLength: 100
        state:
          type: string
          maxLength: 100
        location:
          type: object
          properties:
            latitude:
              type: number
              format: float
            longitude:
              type: number
              format: float
          readOnly: true
        phone_number:
          type: string
          maxLength: 20
        email:
          type: string
          format: email
          maxLength: 254
        website:
          type: string
          format: uri
          maxLength: 200
        description:
          type: string
        services:
          type: string
          title: Services offered
          description: Comma-separated list of services
        operating_hours:
          type: object
          additionalProperties: {}
          description: Return operating hours as structured dict
          readOnly: true
        has_parking:
          type: boolean
        has_wheelchair_access:
          type: boolean
          title: Wheelchair accessible
        has_emergency_service:
          type: boolean
        is_verified:
          type: boolean
          title: Verified
          description: Has this facility been verified by admin?
        is_active:
          type: boolean
          title: Active
          description: Is this facility currently operational?
        average_rating:
          type: string
          format: decimal
          pattern: ^-?\d{0,1}(?:\.\d{0,2})?$
          readOnly: true
        total_reviews:
          type: integer
          readOnly: true
        images:
          type: array
          items:
            $ref: '#/components/schemas/FacilityImage'
          readOnly: true
        distance:
          type: number
          format: float
          description: Get distance from user location if available
          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - address
      - average_rating
      - created_at
      - distance
      - facility_type
      - id
      - images
      - location
      - name
      - operating_hours
      - total_reviews
      - updated_at
    FacilityImage:
      type: object
      description: Serializer for facility images
      properties:
        id:
          type: integer
          readOnly: true
        image:
          type: string
          format: uri
        caption:
          type: string
          maxLength: 255
        is_primary:
          type: boolean
          title: Primary image
          description: Is this the main image for the facility?
        uploaded_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - id
      - image
      - uploaded_at
    FacilityImageRequest:
      type: object
      description: Serializer for facility images
      properties:
        image:
          type: string
          format: binary
        caption:
          type: string
          maxLength: 255
        is_primary:
          type: boolean
          title: Primary image
          description: Is this the main image for the facility?
      required:
      - image
    FacilityList:
      type: object
      description: Serializer for facility list view (lightweight)
      properties:
        id:
          type: integer
          readOnly: true
        name:
          type: string
          title: Facility name
          maxLength: 255
        facility_type:
          $ref: '#/components/schemas/FacilityTypeEnum'
        address:
          type: string
        city:
          type: string
          maxLength: 100
        state:
          type: string
          maxLength: 100
        location:
          type: object
          properties:
            latitude:
              type: number
              format: float
            longitude:
              type: number
              format: float
          readOnly: true
        phone_number:
          type: string
          maxLength: 20
        average_rating:
          type: string
          format: decimal
          pattern: ^-?\d{0,1}(?:\.\d{0,2})?$
        total_reviews:
          type: integer
          maximum: 2147483647
          minimum: -2147483648
        is_verified:
          type: boolean
          title: Verified
          description: Has this facility been verified by admin?
        distance:
          type: number
          format: float
          description: Get distance from user location if available
          readOnly: true
        primary_image:
          type: string
          format: uri
          description: Get primary image URL
          readOnly: true
      required:
      - address
      - distance
      - facility_type
      - id
      - location
      - name
      - primary_image
    FacilityReport:
      type: object
      description: Serializer for facility reports
      properties:
        id:
          type: integer
          readOnly: true
        facility:
          type: integer
        facility_name:
          type: string
          readOnly: true
        reporter:
          allOf:
          - $ref: '#/components/schemas/PublicUser'
          readOnly: true
        reason:
          $ref: '#/components/schemas/ReasonEnum'
        reason_display:
          type: string
          readOnly: true
        description:
          type: string
          description: Detailed explanation of the issue
        status:
          allOf:
          - $ref: '#/components/schemas/StatusEnum'
          readOnly: true
        status_display:
          type: string
          readOnly: true
        admin_notes:
          type: string
          readOnly: true
          description: Internal notes for admins
        images:
          type: array
          items:
            $ref: '#/components/schemas/ReportImage'
          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
          title: Reported at
        updated_at:
          type: string
          format: date-time
          readOnly: true
        resolved_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
      required:
      - admin_notes
      - created_at
      - description
      - facility
      - facility_name
      - id
      - images
      - reason
      - reason_display
      - reporter
      - resolved_at
      - status
      - status_display
      - updated_at
    FacilityState:
      type: object
      properties:
        states:
          type: array
          items:
            type: string
      required:
      - states
    FacilityType:
      type: object
      properties:
        value:
          type: string
        label:
          type: string
      required:
      - label
      - value
    FacilityTypeCount:
      type: object
      description: Single facility_type → count pair.
      properties:
        facility_type:
          type: string
        facility_type_label:
          type: string
        count:
          type: integer
      required:
      - count
      - facility_type
      - facility_type_label
    FacilityTypeEnum:
      enum:
      - hospital
      - clinic
      - pharmacy
      - laboratory
      - diagnostic
      - maternity
      - dental
      - eye
      - physiotherapy
      - other
      type: string
      description: |-
        * `hospital` - Hospital
        * `clinic` - Clinic
        * `pharmacy` - Pharmacy
        * `laboratory` - Laboratory
        * `diagnostic` - Diagnostic Center
        * `maternity` - Maternity Home
        * `dental` - Dental Clinic
        * `eye` - Eye Clinic
        * `physiotherapy` - Physiotherapy Center
        * `other` - Other
    GBVService:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        name:
          type: string
          maxLength: 255
        state:
          type: string
          maxLength: 100
        lga:
          type: string
          maxLength: 100
        organisation_type:
          $ref: '#/components/schemas/OrganisationTypeEnum'
        services:
          type: string
          title: Services offered
        target_group:
          $ref: '#/components/schemas/TargetGroupEnum'
        address:
          type: string
        phone_number:
          type: string
          maxLength: 100
        contact_person:
          type: string
          maxLength: 255
