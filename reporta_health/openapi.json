  /api/v1/facilities/:
    get:
      operationId: v1_facilities_list
      description: |-
        List all facilities with filtering and search
        GET /api/facilities/

        Query parameters:
        - facility_type: Filter by type (hospital, clinic, etc.)
        - search: Search by name
        - ordering: Order by field (e.g., -average_rating, name)
        - is_verified: Filter by verified status
      parameters:
      - in: query
        name: care_level
        schema:
          type: string
          enum:
          - other
          - primary
          - secondary
          - tertiary
        description: |-
          * `primary` - Primary
          * `secondary` - Secondary
          * `tertiary` - Tertiary
          * `other` - Other
      - in: query
        name: city
        schema:
          type: string
      - in: query
        name: city__icontains
        schema:
          type: string
      - in: query
        name: facility_type
        schema:
          type: string
          enum:
          - clinic
          - dental
          - diagnostic
          - eye
          - hospital
          - laboratory
          - maternity
          - other
          - pharmacy
          - physiotherapy
        description: |-
          * `hospital` - Hospital
          * `clinic` - Clinic
          * `pharmacy` - Pharmacy
          * `laboratory` - Laboratory
          * `diagnostic` - Diagnostic Center
          * `maternity` - Maternity Home
          * `dental` - Dental Clinic
          * `eye` - Eye Clinic
          * `physiotherapy` - Physiotherapy Center
          * `other` - Other
      - in: query
        name: has_emergency_service
        schema:
          type: boolean
      - in: query
        name: has_parking
        schema:
          type: boolean
      - in: query
        name: has_wheelchair_access
        schema:
          type: boolean
      - in: query
        name: is_verified
        schema:
          type: boolean
      - in: query
        name: lga
        schema:
          type: string
      - in: query
        name: lga__icontains
        schema:
          type: string
      - in: query
        name: max_lat
        schema:
          type: number
      - in: query
        name: max_lng
        schema:
          type: number
      - in: query
        name: max_rating
        schema:
          type: number
      - in: query
        name: min_lat
        schema:
          type: number
      - in: query
        name: min_lng
        schema:
          type: number
      - in: query
        name: min_rating
        schema:
          type: number
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - in: query
        name: ownership
        schema:
          type: string
          title: Ownership type
          enum:
          - federal_government
          - lga
          - mission
          - ngo
          - other
          - private
          - state_government
        description: |-
          * `federal_government` - Federal Government
          * `state_government` - State Government
          * `lga` - Local Government (LGA)
          * `private` - Private
          * `mission` - Mission/Faith-based
          * `ngo` - NGO
          * `other` - Other
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - name: search
        required: false
        in: query
        description: A search term.
        schema:
          type: string
      - in: query
        name: state
        schema:
          type: string
      - in: query
        name: state__icontains
        schema:
          type: string
      tags:
      - v1
      security:
      - jwtAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedFacilityListList'
          description: ''
